<?xml version="1.0" encoding="utf-8"?>
<!-- Bundled editorial serif (Source Serif 4, OFL): headlines with an
     Anthropic register. Sans UI text stays on the platform face. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/source_serif4_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/source_serif4_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
